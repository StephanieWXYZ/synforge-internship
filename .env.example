# Set true only when the Cognito client and callback are live. This disables
# creation of new local-password accounts while preserving legacy sign-in/linking.
OIDC_ROLLOUT_ENABLED="false"
LLM_API_KEY=""
LLM_MODEL="gpt-4.1-mini"
EMBEDDING_MODEL="text-embedding-3-small"
# Optional OpenAI-compatible endpoint override.
LLM_BASE_URL="https://api.openai.com/v1"

# Retrieval backend. Keep "database" for local development and migration fallback.
VECTOR_STORE="database"
# Required only when VECTOR_STORE="s3-vectors".
VECTOR_BUCKET_NAME=""
VECTOR_INDEX_NAME="chunks-v1-1536"
VECTOR_DIMENSION="1536"
VECTOR_EMBEDDING_VERSION="v1"

# Optional. Production uses SQS; leave blank for synchronous local processing.
DOCUMENT_QUEUE_URL=""
WORKER_SECRET_NAME=""
